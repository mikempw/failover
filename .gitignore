# Local environment and credential files
.env
.env.*
!.env.example
failover/.env.primary
failover/.env.dr
!failover/.env.primary.example
!failover/.env.dr.example

# Runtime secrets (only documentation/examples are committed)
secrets/*
!secrets/README.md
!secrets/*.example
!secrets/failover/
secrets/failover/*
!secrets/failover/*.example

# Custom DNS provider scripts generated by failover/setup.py
scripts/*
!scripts/README.md

# Runtime state and local data
state/
failover/state/
*.state.json

# Python/test artifacts
__pycache__/
*.py[cod]
.coverage
.pytest_cache/

# IDE/OS artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
