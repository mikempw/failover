# Non-secret deployment settings. Copy to .env to override these examples.
BIND_ADDRESS=127.0.0.1
AST_NETWORK_SUBNET=172.30.0.0/24
CLICKHOUSE_DATABASE=ast
CLICKHOUSE_USER=ast
GRAFANA_ADMIN_USER=ast-admin
GRAFANA_CLICKHOUSE_USER=grafana

# Secret file locations are resolved by Docker Compose on the host.
CLICKHOUSE_PASSWORD_FILE=./secrets/clickhouse_password.txt
GRAFANA_CLICKHOUSE_PASSWORD_FILE=./secrets/grafana_clickhouse_password.txt
PRIMARY_CLICKHOUSE_PASSWORD_FILE=./secrets/primary_clickhouse_password.txt
GRAFANA_ADMIN_PASSWORD_FILE=./secrets/grafana_admin_password.txt
FAILOVER_SECRETS_DIR=./secrets/failover

# DNS-only deployment health targets. These must be endpoints owned by the
# externally managed data plane; WireGuard itself is not a health endpoint.
DNS_ONLY_PRIMARY_HEALTH_URL=http://192.0.2.10:8080/health
DNS_ONLY_DR_HEALTH_URL=http://192.0.2.20:8080/health
DNS_ONLY_PRIMARY_FAILBACK_HEALTH_URL=http://192.0.2.10:8080/recovery-ready

# Comma-separated CIDRs allowed to reach the main ClickHouse account from a
# peer/recovery network. Leave empty when ClickHouse is host-local only.
CLICKHOUSE_REMOTE_CIDRS=

# Cross-site endpoints for the default built-in replication mode. Replace
# TEST-NET addresses before deployment. The external-replication Compose
# overlays disable the consumers of these values.
PRIMARY_VM_URL=http://192.0.2.10:8428
DR_VM_URL=http://192.0.2.20:8428
PRIMARY_VM_WRITE_URL=http://192.0.2.10:8428/api/v1/write
DR_VM_WRITE_URL=http://192.0.2.20:8428/api/v1/write
PRIMARY_CLICKHOUSE_SCHEME=http
PRIMARY_CLICKHOUSE_HOST=192.0.2.10
PRIMARY_CLICKHOUSE_HTTP_PORT=8123
PRIMARY_CLICKHOUSE_USER=ast

# Built-in replication cadence. Ignored by the external-replication overlays.
VM_SYNC_INTERVAL=300
VM_SYNC_LOOKBACK=30
# Optional Unix timestamp used only when the durable watermark is absent.
# Keep it configured to make state-volume recovery deterministic.
VM_SYNC_START_TIMESTAMP=
CH_SYNC_INTERVAL=300
CH_SYNC_DATABASES=ast

# Safe, configuration-valid receiver placeholder. Point this at a generated
# receivers.yaml before collecting from real BIG-IP devices.
OTEL_RECEIVERS_FILE=./services/otel_collector/receivers.example.yaml
OTEL_SECRETS_DIR=./services/otel_collector/example-secrets
OTEL_CHECK_INTERVAL=15
OTEL_BOOTSTRAP_STABLE_CHECKS=3
OTEL_BOOTSTRAP_CHECK_INTERVAL=2
# Optional container-reachable resolver; otherwise Docker's resolver is used.
# OTEL_BOOTSTRAP_DNS_SERVER=192.0.2.53

# A production OTel secret directory should contain the files referenced by
# the receiver/exporter configuration (for example, bigip_password and the
# complete "kovacs <sensor-id> <token>" datafabric_authorization header).
