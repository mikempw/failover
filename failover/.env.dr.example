# AST DNS Failover - DR Site Configuration
#
# Copy to failover/.env.dr and edit. The real file is gitignored.
# Used by both dns-failover and otel-watcher, so DNS_RECORD / PRIMARY_IP /
# DR_IP must be the record and site IPs the watcher should compare against.

ROLE=dr

# DNS Provider: bind-tsig | ad-gss | infoblox | cloudflare | route53 | azure-dns | gcp-dns | f5-gtm | script | dry-run
DNS_PROVIDER=bind-tsig

# DNS Server Settings
DNS_SERVER=10.10.1.53
DNS_ZONE=customer.local
DNS_RECORD=syslog.ast.customer.local
DNS_TTL=30

# Failover IPs
PRIMARY_IP=10.10.10.10
DR_IP=10.20.20.10

# Lease Settings
LEASE_TTL=60
UPDATE_INTERVAL=10
FAIL_THRESHOLD=3

# Health Check (DR checks Primary)
# tcp mode: connect to HEALTH_HOST:HEALTH_PORT. 8888 is the primary OTEL
# collector's telemetry port, published by docker-compose.primary.yaml.
HEALTH_MODE=tcp
HEALTH_HOST=10.10.10.10
HEALTH_PORT=8888
HEALTH_TIMEOUT=2
# metrics mode (stronger: checks the collector is actually ingesting):
# HEALTH_MODE=metrics
# HEALTH_URL=http://10.10.10.10:8888/metrics
# HEALTH_METRIC=otelcol_receiver_accepted_metric_points
# HEALTH_STALE_COUNT=3

# BIND TSIG (if DNS_PROVIDER=bind-tsig)
# Put the key at failover/secrets/tsig.key (mounted read-only at /secrets).
TSIG_KEYFILE=/secrets/tsig.key

# Infoblox (if DNS_PROVIDER=infoblox)
# INFOBLOX_HOST=infoblox.customer.local
# INFOBLOX_USERNAME=admin
# INFOBLOX_PASSWORD=secret
# INFOBLOX_WAPI_VERSION=v2.11
# INFOBLOX_VERIFY_SSL=true

# Dry-run (if DNS_PROVIDER=dry-run)
DRYRUN_STATEFILE=/state/zone.json
