# Safe example configuration for the disaster-recovery site. Copy to .env.dr
# and replace TEST-NET/example values before deployment.
ROLE=dr
DNS_PROVIDER=dry-run
DNS_SERVER=127.0.0.1
DNS_ZONE=example.test
DNS_RECORD=failover.example.test
DNS_TTL=30
PRIMARY_IP=192.0.2.10
DR_IP=192.0.2.20
LEASE_TTL=60
UPDATE_INTERVAL=10
FAIL_THRESHOLD=3
AUTO_FAILBACK=false
FAILBACK_THRESHOLD=3
MAX_CLOCK_SKEW=5
HEALTH_MODE=http
HEALTH_HOST=192.0.2.10
HEALTH_PORT=4317
HEALTH_TIMEOUT=2
HEALTH_URL=http://192.0.2.10:8888/metrics
# DR-visible recovery probe for the primary; required before AUTO_FAILBACK=true.
FAILBACK_HEALTH_URL=http://192.0.2.10:8428/health
LOCAL_HEALTH_URL=http://victoriametrics:8428/health
HEALTH_STALE_COUNT=3
DRYRUN_STATEFILE=/state/zone.json
LEASE_PROOF_FILE=/state/observed-lease.json
STATUS_PORT=8080
