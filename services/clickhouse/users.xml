<!--
  secure-entrypoint.sh generates the runtime users with SHA-256 password hashes
  and CIDR allowlists. This static file only defines shared profiles and quotas;
  it intentionally defines no blank-password user.
-->
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>10000000000</max_memory_usage>
            <load_balancing>random</load_balancing>
        </default>
        <grafana_readonly>
            <readonly>1</readonly>
            <constraints>
                <max_execution_time>
                    <changeable_in_readonly />
                </max_execution_time>
            </constraints>
        </grafana_readonly>
    </profiles>

    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>
