# Compose inputs for the standalone DNS-only control plane. Copy this file to
# .env on both sites and replace every TEST-NET endpoint before activation.
FAILOVER_SECRETS_DIR=./secrets/failover

# These are direct, site-specific endpoints owned by the external data plane.
# Do not use DNS_RECORD here: that record moves when failover occurs.
DNS_ONLY_PRIMARY_HEALTH_URL=http://192.0.2.10:8080/health
DNS_ONLY_DR_HEALTH_URL=http://192.0.2.20:8080/ready-for-traffic

# This is intentionally separate from ordinary primary health. The external
# owner decides what recovery/fencing checks it performs before returning 2xx.
DNS_ONLY_PRIMARY_FAILBACK_HEALTH_URL=http://192.0.2.10:8080/recovery-ready
